generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Roles: ADMIN, ASSET_MANAGER, DEPARTMENT_HEAD, EMPLOYEE
// Status: ACTIVE, INACTIVE
// AssetStatus: AVAILABLE, ALLOCATED, RESERVED, UNDER_MAINTENANCE, LOST, RETIRED, DISPOSED
// BookingStatus: UPCOMING, ONGOING, COMPLETED, CANCELLED
// MaintenanceStatus: PENDING, APPROVED, REJECTED, IN_PROGRESS, RESOLVED
// AuditStatus: VERIFIED, MISSING, DAMAGED

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  password     String
  name         String
  role         String      @default("EMPLOYEE") // ADMIN, ASSET_MANAGER, DEPARTMENT_HEAD, EMPLOYEE
  status       String      @default("ACTIVE")   // ACTIVE, INACTIVE
  departmentId String?
  department   Department? @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  managedDepartments Department[] @relation("DepartmentHead")
  bookings           Booking[]
  maintenanceReqs    MaintenanceRequest[]
  auditResults       AuditResult[]
}

model Department {
  id        String   @id @default(uuid())
  name      String
  headId    String?
  head      User?    @relation("DepartmentHead", fields: [headId], references: [id])
  parentId  String?
  parent    Department? @relation("SubDepartments", fields: [parentId], references: [id])
  children  Department[] @relation("SubDepartments")
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees User[] @relation("DepartmentEmployees")
}

model AssetCategory {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  assets Asset[]
}

model Asset {
  id              String      @id @default(uuid())
  assetTag        String      @unique
  categoryId      String
  category        AssetCategory @relation(fields: [categoryId], references: [id])
  name            String
  serialNumber    String?
  acquisitionDate DateTime?
  acquisitionCost Float?
  condition       String?
  location        String?
  isBookable      Boolean     @default(false)
  status          String      @default("AVAILABLE") // AVAILABLE, ALLOCATED, RESERVED, UNDER_MAINTENANCE, LOST, RETIRED, DISPOSED
  assignedToUser  String?
  assignedToDept  String?
  expectedReturn  DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  bookings        Booking[]
  maintenance     MaintenanceRequest[]
  auditResults    AuditResult[]
}

model Booking {
  id        String        @id @default(uuid())
  assetId   String
  asset     Asset         @relation(fields: [assetId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  startTime DateTime
  endTime   DateTime
  status    String        @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED, CANCELLED
  createdAt DateTime      @default(now())
}

model MaintenanceRequest {
  id            String            @id @default(uuid())
  assetId       String
  asset         Asset             @relation(fields: [assetId], references: [id])
  requestedBy   String
  requester     User              @relation(fields: [requestedBy], references: [id])
  description   String
  priority      String
  status        String            @default("PENDING") // PENDING, APPROVED, REJECTED, IN_PROGRESS, RESOLVED
  technicianId  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model AuditCycle {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  results   AuditResult[]
}

model AuditResult {
  id           String      @id @default(uuid())
  auditCycleId String
  auditCycle   AuditCycle  @relation(fields: [auditCycleId], references: [id])
  assetId      String
  asset        Asset       @relation(fields: [assetId], references: [id])
  status       String      // VERIFIED, MISSING, DAMAGED
  notes        String?
  auditedBy    String
  auditor      User        @relation(fields: [auditedBy], references: [id])
  auditedAt    DateTime    @default(now())
}
